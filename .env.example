# =====================================================================
# SIGRH - variables d'environnement de production (VPS OVH)
# Copier ce fichier en .env et renseigner les valeurs réelles.
#   cp .env.example .env
# Le fichier .env ne doit JAMAIS être commité.
# =====================================================================

# --- Domaine (pointant vers l'IP du VPS) ---------------------------
# Mettre le domaine réel pour activer HTTPS automatique (Let's Encrypt).
# Pour un test en HTTP simple sans domaine, utiliser DOMAIN=":80".
DOMAIN=sigrh.mondomaine.com
FRONTEND_URL=https://sigrh.mondomaine.com
CORS_ORIGINS=https://sigrh.mondomaine.com,http://localhost:5173

# --- Base de données PostgreSQL ------------------------------------
POSTGRES_DB=sigrh
POSTGRES_USER=sigrh
POSTGRES_PASSWORD=changez-moi-en-un-mot-de-passe-fort
TZ=Africa/Douala

# --- Sécurité JWT --------------------------------------------------
# Secret HS256, minimum 32 caractères. Générer avec :
#   openssl rand -base64 48
JWT_SECRET=changez-moi-avec-un-secret-aleatoire-dau-moins-32-caracteres

# --- Mémoire allouée au backend Java (Mo) --------------------------
BACKEND_HEAP_MB=1024

# --- Email (Gmail par défaut, ou Brevo) ----------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# gmail | brevo
MAIL_PROVIDER=gmail
BREVO_API_KEY=
ALERT_RECIPIENTS=

# --- Données de démonstration (générées si la base est vide) -------
SEED_ENABLED=true
SEED_EMPLOYEES=150
SEED_PRESENCE_DAYS=30
SEED_MONTHS_PAIE=6
SEED_MATERIELS=200
DEFAULT_PASSWORD=SIGRH@2026